{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astra-tactics-online",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "OnlineRoom"
      }
    ]
  },
  "exports": {
    "OnlineRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}